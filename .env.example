# Адреса бекенду itcodecraft-platform (без / в кінці).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Вхід через Google: ID клієнтів з Google Cloud Console.
# Web-клієнт обовʼязковий (саме він — audience токена, який перевіряє бекенд:
# додайте його в GOOGLE_MOBILE_CLIENT_IDS на сервері). iOS-клієнт потрібен лише на iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
