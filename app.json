{
  "expo": {
    "name": "ITCodeCraft",
    "slug": "itcodecraft-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tech.itcodecraft.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C5CFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "tech.itcodecraft.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.733888533837-2cf0r3dl4lhveduh7mdl7utp0oqj1m7i"
        }
      ],
      "expo-status-bar",
      "expo-iap"
    ],
    "scheme": "itcodecraft",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://learning-platform-alpha-jet.vercel.app",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "de66db6b-0da0-4bf6-a146-53e40f14d18a"
      }
    },
    "owner": "itcodecraft"
  }
}
